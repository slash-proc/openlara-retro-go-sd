+void laraApplyFlow(Lara* lara, int32 sinkIndex)
+{
+    if (!lara || sinkIndex < 0 || sinkIndex >= level.camerasCount)
+        return;
+
+    const FixedCamera &sink = level.cameras[sinkIndex];
+    vec3i target = sink.pos;
+    int32 speed = sink.roomIndex * 6;
+
+    bool inWater = (lara->waterState == WATER_STATE_UNDER ||
+                    lara->waterState == WATER_STATE_SURFACE);
+    Camera &cam = lara->extraL->camera;
+    bool cinematic = (cam.mode == CAMERA_MODE_OBJECT || cam.mode == CAMERA_MODE_FIXED);
+
+    if (!inWater && !cinematic)
+        return;
+
+    if (lara->waterState == WATER_STATE_SURFACE && !lara->extraL->dozy)
+    {
+        lara->waterState = WATER_STATE_UNDER;
+        lara->flags &= ~ITEM_FLAG_GRAVITY;
+        lara->animSet(Lara::ANIM_UNDERWATER, true);
+        lara->state = Lara::STATE_UW_SWIM;
+        lara->oxygen = LARA_MAX_OXYGEN;
+    }
+
+    if (lara->waterState == WATER_STATE_ABOVE && cinematic)
+    {
+        int32 dx = target.x - lara->pos.x;
+        int32 dz = target.z - lara->pos.z;
+
+        if (abs(dz) >= abs(dx)) {
+            lara->angle.y = (dz >= 0) ? ANGLE_90 : -ANGLE_90;
+        } else {
+            lara->angle.y = (dx >= 0) ? 0 : ANGLE_180;
+        }
+
+        if (lara->state != Lara::STATE_RUN && lara->state != Lara::STATE_WALK) {
+            lara->animSet(Lara::ANIM_RUN, true);
+        }
+        lara->state = Lara::STATE_RUN;
+    }
+
+    lara->pos.x += X_CLAMP(target.x - lara->pos.x, -speed, speed);
+    lara->pos.y += X_CLAMP(target.y - lara->pos.y, -speed, speed);
+    lara->pos.z += X_CLAMP(target.z - lara->pos.z, -speed, speed);
 }
 
