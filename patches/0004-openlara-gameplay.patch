+struct MidasHand : Object
+{
+    bool interaction;
+
+    MidasHand(Room* room) : Object(room), interaction(false)
+    {
+        activate();
+    }
+
+    void applyLeadBar(Lara* lara)
+    {
+        if (lara->extraL->weaponState != WEAPON_STATE_FREE)
+            return;
+
+        if (inventory.counts[SLOT_LEADBAR] <= 0)
+            return;
+
+        lara->angle.y = ANGLE_90;
+        lara->pos.x = pos.x - 612;
+
+        inventory.remove(SLOT_LEADBAR, 1);
+        inventory.add(ITEM_PUZZLE_1);
+        inventory.useSlot = SLOT_MAX;
+
+        lara->meshSwap(ITEM_LARA_SPEC, 0xFFFFFFFF);
+        lara->animSet(level.models[ITEM_LARA_SPEC].animIndex, true);
+        lara->extraL->weaponState = WEAPON_STATE_BUSY;
+        interaction = false;
+    }
+
+    void applyGoldDeath(Lara* lara)
+    {
+        if (lara->state == Lara::STATE_USE_MIDAS ||
+            lara->state == Lara::STATE_DEATH_MIDAS)
+            return;
+
+        lara->health = 0;
+        lara->flags &= ~ITEM_FLAG_GRAVITY;
+        lara->meshSwap(ITEM_LARA_SPEC, 0xFFFFFFFF);
+        lara->animSet(level.models[ITEM_LARA_SPEC].animIndex + 1, true);
+        lara->extraL->weaponState = WEAPON_STATE_BUSY;
+    }
+
+    virtual void update()
+    {
+        Object::update();
+
+        Lara* lara = getLara(pos);
+        if (!lara || lara->health <= 0)
+            return;
+
+        if (lara->waterState != WATER_STATE_ABOVE)
+            return;
+
+        if (lara->room != room)
+            return;
+
+        vec3i d = lara->pos - pos;
+        d.x = abs(d.x);
+        d.z = abs(d.z);
+
+        if (d.x < 512 && d.z < 512)
+        {
+            applyGoldDeath(lara);
+            return;
+        }
+
+        interaction = (d.x < 700 && d.z < 700) &&
+                      (lara->state == Lara::STATE_STOP);
+
+        if (!interaction)
+            return;
+
+        if (inventory.useSlot == SLOT_LEADBAR)
+        {
+            applyLeadBar(lara);
+            return;
+        }
+
+        if (lara->extraL->weaponState != WEAPON_STATE_FREE)
+            return;
+
+        if (lara->isKeyHit(IN_ACTION) && inventory.useSlot == SLOT_MAX)
+        {
+            if (inventory.counts[SLOT_LEADBAR] > 0)
+            {
+                inventory.open(lara, INV_PAGE_KEYS);
+                inventory.itemIndex = inventory.nextIndex =
+                    inventory.getItemIndexForSlot(SLOT_LEADBAR);
+                inventory.setRot(ANGLE_180,
+                    inventory.itemIndex * ANGLE_360 / inventory.itemsCount);
+                inventory.rot = inventory.rotTarget - ANGLE_180;
+            }
+            else
+            {
+                soundPlay(SND_NO, &lara->pos);
+            }
+        }
+    }
+};
