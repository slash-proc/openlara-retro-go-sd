+                if (rand_logic() < 0x0147) {
+                    nextState = STATE_WALK;
+                    return STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_WALK:
+            {
+                extraE->maxTurn = ENEMY_TURN_2;
+                if (mood == MOOD_SLEEP && rand_logic() < 0x0147)
+                    nextState = STATE_WAIT;
+                else if (mood == MOOD_ESCAPE)
+                    nextState = STATE_RUN;
+                else if (targetIsVisible(HUMAN_DIST_SHOT))
+                    nextState = STATE_AIM;
+                else if (!tinfo.front || tinfo.dist > HUMAN_DIST_WALK)
+                    nextState = STATE_RUN;
+                else
+                    break;
+                return STATE_STOP;
+            }
+
+            case STATE_RUN:
+            {
+                extraE->maxTurn = ENEMY_TURN_5;
+                if (mood == MOOD_SLEEP && rand_logic() < 0x0147)
+                    nextState = STATE_WAIT;
+                else if (targetIsVisible(HUMAN_DIST_SHOT))
+                    nextState = STATE_AIM;
+                else if (tinfo.front && tinfo.dist < HUMAN_DIST_WALK)
+                    nextState = STATE_WALK;
+                else
+                    break;
+                return STATE_STOP;
+            }
+
+            case STATE_AIM:
+            {
+                if (nextState)
+                    return nextState;
+                if (targetIsVisible(HUMAN_DIST_SHOT))
+                    return STATE_FIRE;
+                return STATE_STOP;
+            }
+
+            case STATE_FIRE:
